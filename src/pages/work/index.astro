---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <div class="page">
    <h1>Work</h1>

    <div class="section">
      <h2 class="section-label">case studies</h2>
      <div class="work-list">
        {featuredProjects.map((project, index) => {
          const slug = project.id.replace(/\.mdx$/, '');
          return (
            <a class="work-row" href={`/work/${slug}`}>
              <div class="work-index">{String(index + 1).padStart(2, '0')}</div>
              <div class="work-title">{project.data.title}</div>
              <div class="work-summary">{project.data.summary}</div>
              <div class="work-year">{project.data.year}</div>
            </a>
          );
        })}
      </div>
    </div>

    <div class="section">
      <h2 class="section-label">also built</h2>
      <div class="work-list">
        <a class="work-row is-inline" href="https://github.com/0xASR-dev/IESCP-V2" target="_blank" rel="noopener noreferrer">
          <div class="work-title">IESCP-V2</div>
          <div class="work-summary">A platform where sponsors and influencers coordinate campaigns and ad requests</div>
          <div class="work-year">2023</div>
        </a>
        <a class="work-row is-inline" href="https://github.com/0xASR-dev/FinScope" target="_blank" rel="noopener noreferrer">
          <div class="work-title">FinScope</div>
          <div class="work-summary">A financial data visualization tool</div>
          <div class="work-year">2023</div>
        </a>
      </div>
    </div>
  </div>

  <style>
    .section {
      margin: var(--space-8) 0;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
      margin-bottom: var(--space-3);
    }

    .work-list {
      margin-top: var(--space-3);
    }

    .work-row {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 1.8fr) auto;
      gap: var(--space-4);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--rule);
      align-items: center;
      text-decoration: none;
      color: inherit;
    }

    .work-row.is-inline {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr) auto;
    }

    .work-index {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
    }

    .work-title {
      font-size: var(--step-1);
      font-weight: 500;
    }

    .work-summary {
      color: var(--ink-muted);
    }

    .work-year {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
      justify-self: end;
    }

    .work-row:hover .work-title,
    .work-row:hover .work-summary,
    .work-row:hover .work-year {
      color: var(--accent);
    }

    @media (max-width: 720px) {
      .work-row,
      .work-row.is-inline {
        grid-template-columns: 1fr;
        gap: var(--space-2);
      }

      .work-year {
        justify-self: start;
      }
    }
  </style>
</Base>