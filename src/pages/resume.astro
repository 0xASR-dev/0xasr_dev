---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const profile = (await getCollection('profile'))[0]?.data;
---

<Base>
  <div class="page">
    <h1>{profile?.name ?? 'Avneesh Singh'}</h1>
    <p class="descriptor">{profile?.descriptor ?? 'Software engineer working across IoT, data and the web'}</p>

    <div class="bio">
      <p>
        {profile?.intro ??
          "I'm finishing a B.Tech in IoT at MITS Gwalior and a BS in Data Science at IIT Madras. I build things that take readings from the physical world or from public data and turn them into something people can act on."}
      </p>
    </div>

    <div class="section">
      <h2 class="section-label">experience</h2>
      <div class="experience-list">
        <div class="experience-row">
          <div class="experience-meta">Jul 2026 – present</div>
          <div class="experience-title">Freelance full-stack developer</div>
          <div class="experience-summary">Building full-stack web applications and contributing to open-source projects.</div>
        </div>
        <div class="experience-row">
          <div class="experience-meta">Mar – Jun 2026</div>
          <div class="experience-title">Data analytics and management intern</div>
          <div class="experience-summary">Codec Technologies</div>
        </div>
        <div class="experience-row">
          <div class="experience-meta">Sep 2025 – Sep 2026</div>
          <div class="experience-title">Technical Head</div>
          <div class="experience-summary">Led a 500+ member technical community at Sundarbans House, IIT Madras BS programme.</div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-label">education</h2>
      <div class="education-list">
        {(profile?.education ?? []).map((item) => (
          <div class="education-row">
            <div class="education-school">{item.school}</div>
            <div class="education-program">{item.program}</div>
            <div class="education-years">{item.years}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="section">
      <h2 class="section-label">contact</h2>
      <div class="contact">
        <copy-email email={profile?.email ?? 'avneeshsingh.job@gmail.com'}></copy-email>
      </div>
    </div>

    <div class="section">
      <a href="/resume.pdf" class="download-resume" download>Download PDF</a>
    </div>
  </div>

  <style>
    .descriptor {
      color: var(--ink-muted);
      font-size: var(--step-0);
      margin: var(--space-2) 0;
    }

    .bio {
      margin: var(--space-6) 0;
    }

    .section {
      margin: var(--space-8) 0;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
      margin-bottom: var(--space-3);
    }

    .experience-list, .education-list {
      margin-top: var(--space-3);
    }

    .experience-row, .education-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--rule);
      align-items: center;
    }

    .experience-meta {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
    }

    .experience-title {
      font-size: var(--step-1);
      font-weight: 500;
    }

    .experience-summary {
      color: var(--ink-muted);
      margin-top: var(--space-2);
    }

    .education-school {
      font-size: var(--step-1);
      font-weight: 500;
    }

    .education-program {
      color: var(--ink-muted);
    }

    .education-years {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--ink-muted);
    }

    .contact {
      margin-top: var(--space-4);
    }

    .download-resume {
      display: inline-block;
      margin-top: var(--space-4);
      color: var(--ink-muted);
      text-decoration: none;
      font-size: var(--step-0);
      transition: color var(--dur-fast) ease-out;
    }

    .download-resume:hover,
    .download-resume:focus-visible {
      color: var(--accent);
    }
  </style>
</Base>